# Copy this file to .env.local and fill in the values.
#   cp .env.local.example .env.local
#
# .env.local is gitignored — never commit real keys.

# Google Gemini API key. SERVER-SIDE ONLY — this is read by the Express server
# (server.ts) and must never be exposed to the client bundle.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Port the Express server binds to. Defaults to 3000 if unset.
# PORT=3000
